# ===== aipay-402-gateway 配置 =====
# 支付提供方：mock=内置模拟，可无密钥跑通全链路；alipay=对接支付宝 AI 付真实接口
AIPAY_PROVIDER=mock

# SQLite 数据库路径
AIPAY_DB_PATH=./aipay_gateway.db

# 服务与商户
AIPAY_BASE_URL=http://localhost:8000
AIPAY_SERVICE_ID=srv_demo_0001
AIPAY_CURRENCY=CNY

# 预下单支付有效期（分钟）
AIPAY_PAY_BEFORE_MINUTES=30

# ===== 以下仅 alipay 模式需要（请勿提交真实密钥到仓库）=====
AIPAY_APP_ID=
AIPAY_APP_PRIVATE_KEY=
AIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
AIPAY_SANDBOX_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
AIPAY_USE_SANDBOX=true
